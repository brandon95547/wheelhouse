# Copy to .env and fill in. .env is gitignored; this file is not.
#
# DeepSeek classifies imported sold listings into Rare / Common / Not worthy. It is
# OPTIONAL: with no key the import still works and brands are tiered by the statistical
# scorer alone, which needs no third party. See server/src/lib/brand-ai.ts.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Must be a NON-reasoning model. The reasoning variants (deepseek-v4-flash and
# friends) spend their whole token budget thinking and emit nothing on a full batch.
DEEPSEEK_MODEL=deepseek-chat
