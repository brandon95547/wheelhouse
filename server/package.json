{
  "name": "wheelhouse-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wheelhouse backend — Express + SQLite",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "tsx src/scripts/init-db.ts",
    "db:reset": "tsx src/scripts/reset-db.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
