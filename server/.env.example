# Copy to .env and fill in. .env is gitignored; this file is not.
#
# The model classifies imported sold listings into Rare / Common / Not worthy / Unsorted.
# It is OPTIONAL: with no key the import still works and brands are tiered by the
# statistical scorer alone, which needs no third party. See server/src/lib/brand-ai.ts.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Any OpenAI-compatible endpoint. Leave unset for OpenAI itself.
# OPENAI_BASE_URL=https://api.openai.com/v1
