{
  "manifest_version": 3,
  "name": "Lookout — thrift brand scout",
  "version": "0.1.0",
  "description": "Scans eBay sold listings for the brands and models worth sourcing, using your Reseller Brand Guide, and sends what it finds to Wheelhouse.",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.ebay.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Lookout",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
